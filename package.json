{
  "name": "tikr",
  "version": "1.0.0",
  "description": "Track token usage across Claude Code, Codex and GitHub Copilot CLI. Local, encrypted, append-only.",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "copilot",
    "tokens",
    "usage",
    "cost",
    "cli"
  ],
  "license": "MIT",
  "author": "Mubashir Jamali <mubashirjamali101@gmail.com> (https://mubashirjamali.com/en/open-source/tikr)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tikr": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src test scripts",
    "format": "biome format --write src test scripts",
    "rates": "node scripts/generate-rates.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "tsc",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mubashirjamali101/tikr.git"
  },
  "homepage": "https://mubashirjamali.com/en/open-source/tikr",
  "bugs": {
    "url": "https://github.com/mubashirjamali101/tikr/issues",
    "email": "security@mubashirjamali.com"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.3",
      "esbuild": ">=0.25.0",
      "vitest": ">=3.2.6"
    }
  }
}
